# IMAKECORE_ROOT / IMAKECORE_SYSTEM: prefer qmake variable (set in .pro),
# fall back to environment variable, then system default.
# $$absolute_path() strips trailing whitespace that can break $$system().
isEmpty(IMAKECORE_ROOT): IMAKECORE_ROOT = $$absolute_path($$(IMAKECORE_ROOT))
isEmpty(IMAKECORE_SYSTEM): IMAKECORE_SYSTEM = $$absolute_path($$(IMAKECORE_SYSTEM))
isEmpty(IMAKECORE_SYSTEM): IMAKECORE_SYSTEM = $$absolute_path($$IMAKECORE_ROOT/.system)

QMAKE_SOURCE_DIR =

defineTest(IQMakeCoreInit){
    QMAKE_SOURCE_DIR = $$PWD
    export(QMAKE_SOURCE_DIR)
    findPythonInterpreter()

    # If the .pro file did not set these (real project), fall back to env.
    # Test .pro files set them explicitly — keep those values.
    isEmpty(IMAKECORE_ROOT): IMAKECORE_ROOT = $$absolute_path($$(IMAKECORE_ROOT))
    isEmpty(IMAKECORE_SYSTEM): IMAKECORE_SYSTEM = $$absolute_path($$(IMAKECORE_SYSTEM))
    isEmpty(IMAKECORE_SYSTEM): IMAKECORE_SYSTEM = $$absolute_path($$IMAKECORE_ROOT/.system)

    script_path = $$getPythonFilePath("IMakeCore.py")
    win32: cmd = set IMAKECORE_ROOT=$$IMAKECORE_ROOT && set IMAKECORE_SYSTEM=$$IMAKECORE_SYSTEM && $$python -B $$script_path $$PWD qmake
    unix:  cmd = IMAKECORE_ROOT="$$IMAKECORE_ROOT" IMAKECORE_SYSTEM="$$IMAKECORE_SYSTEM" $$python -B $$script_path $$PWD qmake
#    message($$cmd)

    !exists($$PWD/packages.json){
#        error("$$PWD/package.json configure file not exist, please create one")
    }

    res = $$system($$cmd, blob, result)
    ! isEqual(res, "") {
        message($$res)
    }
    ! isEqual(result, 0) {
        error("packages configuration failed")
        return(false)
    }
    message("packages configured successfully")
    return(true)
}

defineTest(findPythonInterpreter) {
    win32 {
        python = $$system(where python /F)
        python = $$first(python)
        isEmpty(python): python = $$system(where python3)
    } else {
        python = $$system(which python3 || which python)
    }
    isEmpty(python): {
        error("Python interpreter not found")
        return(false)
    }
    export(python)
    return(true)
}

defineReplace(getPythonFilePath){
    script_path = $$IMAKECORE_SYSTEM/$$1

    !exists($$script_path) {
        error("script not found at $$script_path")
    }
    script_path = $$absolute_path($$script_path)
    return ("$$script_path")
}
