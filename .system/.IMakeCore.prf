QMAKE_SOURCE_DIR =

# ── Helper: get executable output directory ────────────────────────
defineReplace(getExecutablePath) {
    !isEmpty(DESTDIR): return($$DESTDIR)
    return($$OUT_PWD)
}

# ── Helper: get target type ────────────────────────────────────────
defineReplace(getTargetType) {
    contains(TEMPLATE, lib) {
        contains(CONFIG, staticlib): return(static)
        return(dynamic)
    }
    return(executable)
}

# ── Main init function ────────────────────────────────────────────
defineTest(IQMakeCoreInit){
    QMAKE_SOURCE_DIR = $$PWD
    export(QMAKE_SOURCE_DIR)
    findPythonInterpreter()

    isEmpty(IMAKECORE_ROOT){
        IMAKECORE_ROOT = $$(IMAKECORE_ROOT)
    }
    isEmpty(IMAKECORE_SYSTEM) {
        IMAKECORE_SYSTEM = $$IMAKECORE_ROOT/.system
    }

    # ── Compile info: computed inline (no $$member parsing) ────────

    # platform
    win32:   _CI_PLATFORM = windows
    else: linux:  _CI_PLATFORM = linux
    else: macx:   _CI_PLATFORM = macos
    else: _CI_PLATFORM = unknown

    # arch
    contains(QT_ARCH, x86_64)|contains(QT_ARCH, amd64): _CI_ARCH = x86_64
    else: contains(QT_ARCH, i386)|contains(QT_ARCH, x86): _CI_ARCH = x86
    else: contains(QT_ARCH, arm64)|contains(QT_ARCH, aarch64): _CI_ARCH = arm64
    else: _CI_ARCH = $$QT_ARCH
    isEmpty(_CI_ARCH): _CI_ARCH = unknown

    # compiler
    msvc: _CI_COMPILER = msvc
    else: win32-g++: _CI_COMPILER = gcc
    else: linux-g++|linux-g++-64: _CI_COMPILER = gcc
    else: clang|linux-clang: _CI_COMPILER = clang
    else: _CI_COMPILER = unknown

    # compiler version (run once, trim)
    _CI_COMPILER_VERSION = $$system($$QMAKE_CXX -dumpversion 2>nul || echo 0)
    isEmpty(_CI_COMPILER_VERSION): _CI_COMPILER_VERSION = unknown

    # build mode
    CONFIG(debug, debug|release): _CI_BUILD_MODE = debug
    else: _CI_BUILD_MODE = release

    # runtimes
    win32-msvc {
        contains(QMAKE_CXXFLAGS, /MD): _CI_RUNTIMES = dynamic
        else: _CI_RUNTIMES = static
    } else: _CI_RUNTIMES = system

    # c++ standard
    contains(CONFIG, c++23)|contains(CONFIG, c++2c): _CI_CPP_STD = 23
    else: contains(CONFIG, c++20)|contains(CONFIG, c++2a): _CI_CPP_STD = 20
    else: contains(CONFIG, c++17)|contains(CONFIG, c++1z): _CI_CPP_STD = 17
    else: contains(CONFIG, c++14)|contains(CONFIG, c++1y): _CI_CPP_STD = 14
    else: contains(CONFIG, c++11)|contains(CONFIG, c++0x): _CI_CPP_STD = 11
    else: _CI_CPP_STD = 17

    # exceptions
    contains(CONFIG, exceptions)|!contains(DEFINES, QT_NO_EXCEPTIONS): _CI_EXCEPTIONS = 1
    else: _CI_EXCEPTIONS = 0

    # rtti
    contains(CONFIG, rtti)|!contains(CONFIG, rtti_off): _CI_RTTI = 1
    else: _CI_RTTI = 0

    script_path = $$getPythonFilePath("IMakeCore.py")
    win32 {
        cmd = set IMAKECORE_ROOT=$$IMAKECORE_ROOT && \
              set IMAKECORE_SYSTEM=$$IMAKECORE_SYSTEM && \
              set IMAKECORE_EXECUTABLE_PATH=$$getExecutablePath() && \
              set IMAKECORE_TARGET_TYPE=$$getTargetType() && \
              set IMAKECORE_PLATFORM=$$_CI_PLATFORM && \
              set IMAKECORE_ARCH=$$_CI_ARCH && \
              set IMAKECORE_COMPILER=$$_CI_COMPILER && \
              set IMAKECORE_COMPILER_VERSION=$$_CI_COMPILER_VERSION && \
              set IMAKECORE_BUILD_MODE=$$_CI_BUILD_MODE && \
              set IMAKECORE_RUNTIMES=$$_CI_RUNTIMES && \
              set IMAKECORE_CPP_STD=$$_CI_CPP_STD && \
              set IMAKECORE_EXCEPTION_ENABLED=$$_CI_EXCEPTIONS && \
              set IMAKECORE_RTTI_ENABLED=$$_CI_RTTI && \
              $$python -B $$script_path $$PWD qmake
    }
    unix {
        cmd = IMAKECORE_ROOT="$$IMAKECORE_ROOT" \
              IMAKECORE_SYSTEM="$$IMAKECORE_SYSTEM" \
              IMAKECORE_EXECUTABLE_PATH="$$getExecutablePath()" \
              IMAKECORE_TARGET_TYPE="$$getTargetType()" \
              IMAKECORE_PLATFORM="$$_CI_PLATFORM" \
              IMAKECORE_ARCH="$$_CI_ARCH" \
              IMAKECORE_COMPILER="$$_CI_COMPILER" \
              IMAKECORE_COMPILER_VERSION="$$_CI_COMPILER_VERSION" \
              IMAKECORE_BUILD_MODE="$$_CI_BUILD_MODE" \
              IMAKECORE_RUNTIMES="$$_CI_RUNTIMES" \
              IMAKECORE_CPP_STD="$$_CI_CPP_STD" \
              IMAKECORE_EXCEPTION_ENABLED="$$_CI_EXCEPTIONS" \
              IMAKECORE_RTTI_ENABLED="$$_CI_RTTI" \
              $$python -B $$script_path $$PWD qmake
    }

    res = $$system($$cmd, blob, result)
    ! isEqual(res, "") {
        message($$res)
    }
    ! isEqual(result, 0) {
        error("packages configuration failed")
        return(false)
    }
    message("packages configured successfully")
    return(true)
}

defineTest(findPythonInterpreter) {
    win32 {
        python = $$system(where python /F)
        python = $$first(python)
        isEmpty(python): python = $$system(where python3)
    } else {
        python = $$system(which python3 || which python)
    }
    isEmpty(python): {
        error("Python interpreter not found")
        return(false)
    }
    export(python)
    return(true)
}

defineReplace(getPythonFilePath){
    script_path = $$IMAKECORE_SYSTEM/$$1
    !exists($$script_path) {
        error("script not found at $$script_path")
    }
    script_path = $$absolute_path($$script_path)
    return ("$$script_path")
}
