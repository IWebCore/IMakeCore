QMAKE_SOURCE_DIR =

defineTest(IQMakeCoreInit){
    QMAKE_SOURCE_DIR = $$PWD
    export(QMAKE_SOURCE_DIR)
    findPythonInterpreter()

    isEmpty(IMAKECORE_ROOT){
        IMAKECORE_ROOT = $$(IMAKECORE_ROOT)
    }

    isEmpty(IMAKECORE_SYSTEM) {
        IMAKECORE_SYSTEM = $$IMAKECORE_ROOT/.system
    }

    script_path = $$getPythonFilePath("IMakeCore.py")
    win32: cmd = set IMAKECORE_ROOT=$$IMAKECORE_ROOT && set IMAKECORE_SYSTEM=$$IMAKECORE_SYSTEM && $$python -B $$script_path $$PWD qmake
    unix:  cmd = IMAKECORE_ROOT="$$IMAKECORE_ROOT" IMAKECORE_SYSTEM="$$IMAKECORE_SYSTEM" $$python -B $$script_path $$PWD qmake

    res = $$system($$cmd, blob, result)
    ! isEqual(res, "") {
        message($$res)
    }
    ! isEqual(result, 0) {
        error("packages configuration failed")
        return(false)
    }
    message("packages configured successfully")
    return(true)
}

defineTest(findPythonInterpreter) {
    win32 {
        python = $$system(where python /F)
        python = $$first(python)
        isEmpty(python): python = $$system(where python3)
    } else {
        python = $$system(which python3 || which python)
    }
    isEmpty(python): {
        error("Python interpreter not found")
        return(false)
    }
    export(python)
    return(true)
}

defineReplace(getPythonFilePath){
    script_path = $$IMAKECORE_SYSTEM/$$1
    !exists($$script_path) {
        error("script not found at $$script_path")
    }
    script_path = $$absolute_path($$script_path)
    return ("$$script_path")
}
