QMAKE_SOURCE_DIR =

# ── Helper: get executable output directory ────────────────────────
defineReplace(getExecutablePath) {
    !isEmpty(DESTDIR): return($$DESTDIR)
    return($$OUT_PWD)
}

# ── Helper: get target type ────────────────────────────────────────
defineReplace(getTargetType) {
    contains(TEMPLATE, lib) {
        contains(CONFIG, staticlib): return(static)
        contains(CONFIG, dll): return(dynamic)
        return(dynamic)
    }
    return(executable)
}

# ── Helper: get compile arguments as a single semicolon-separated string ─
defineReplace(getCompileArguments) {
    # platform
    win32: PLATFORM = windows
    linux: PLATFORM = linux
    macx: PLATFORM = macos
    else: PLATFORM = unknown

    # arch
    contains(QT_ARCH, x86_64)|contains(QT_ARCH, amd64): ARCH = x86_64
    else: contains(QT_ARCH, i386)|contains(QT_ARCH, x86): ARCH = x86
    else: contains(QT_ARCH, arm64)|contains(QT_ARCH, aarch64): ARCH = arm64
    else: ARCH = $$QT_ARCH

    # compiler
    msvc: COMPILER = msvc
    else: win32-g++: COMPILER = gcc
    else: linux-g++: COMPILER = gcc
    else: clang: COMPILER = clang
    else: COMPILER = unknown

    # compiler version
    win32-msvc {
        COMPILER_VERSION = $$(VCToolsVersion)
        isEmpty(COMPILER_VERSION): COMPILER_VERSION = $$MSVC_VER
    } else: gcc|clang {
        COMPILER_VERSION = $$system($$QMAKE_CXX -dumpversion 2>nul || echo 0)
    } else {
        COMPILER_VERSION = unknown
    }

    # build mode
    CONFIG(debug, debug|release): MODE = debug
    else: CONFIG(release, debug|release): MODE = release
    else: MODE = debug

    # runtimes
    win32-msvc {
        contains(QMAKE_CXXFLAGS, /MD): RUNTIMES = dynamic
        else: contains(QMAKE_CXXFLAGS, /MT): RUNTIMES = static
        else: RUNTIMES = dynamic
    } else {
        RUNTIMES = system
    }

    # c++ standard
    contains(CONFIG, c++20)|contains(CONFIG, c++2a): STD = 20
    else: contains(CONFIG, c++17)|contains(CONFIG, c++1z): STD = 17
    else: contains(CONFIG, c++14)|contains(CONFIG, c++1y): STD = 14
    else: contains(CONFIG, c++11)|contains(CONFIG, c++0x): STD = 11
    else: STD = unknown

    # exceptions
    contains(CONFIG, exceptions): EXC = 1
    else: contains(DEFINES, QT_NO_EXCEPTIONS): EXC = 0
    else: EXC = 1

    # rtti
    contains(CONFIG, rtti): RTTI = 1
    else: contains(CONFIG, rtti_off): RTTI = 0
    else: RTTI = 1

    return($$PLATFORM;$$ARCH;$$COMPILER;$$COMPILER_VERSION;$$MODE;$$RUNTIMES;$$STD;$$EXC;$$RTTI)
}


# ── Main init function ────────────────────────────────────────────
defineTest(IQMakeCoreInit){
    QMAKE_SOURCE_DIR = $$PWD
    export(QMAKE_SOURCE_DIR)
    findPythonInterpreter()

    isEmpty(IMAKECORE_ROOT){
        IMAKECORE_ROOT = $$(IMAKECORE_ROOT)
    }

    isEmpty(IMAKECORE_SYSTEM) {
        IMAKECORE_SYSTEM = $$IMAKECORE_ROOT/.system
    }

    # Gather compile info
    EXE_PATH = $$getExecutablePath()
    TARGET_TYPE = $$getTargetType()
    COMPILE_ARGS = $$getCompileArguments()
    PLATFORM = $$member(COMPILE_ARGS, 0)
    ARCH     = $$member(COMPILE_ARGS, 1)
    COMPILER = $$member(COMPILE_ARGS, 2)
    COMPVER  = $$member(COMPILE_ARGS, 3)
    MODE     = $$member(COMPILE_ARGS, 4)
    RUNTIMES = $$member(COMPILE_ARGS, 5)
    CPPSTD   = $$member(COMPILE_ARGS, 6)
    EXC_EN   = $$member(COMPILE_ARGS, 7)
    RTTI_EN  = $$member(COMPILE_ARGS, 8)

    script_path = $$getPythonFilePath("IMakeCore.py")
    win32 {
        cmd = set IMAKECORE_ROOT=$$IMAKECORE_ROOT && \
              set IMAKECORE_SYSTEM=$$IMAKECORE_SYSTEM && \
              set IMAKECORE_EXECUTABLE_PATH=$$EXE_PATH && \
              set IMAKECORE_TARGET_TYPE=$$TARGET_TYPE && \
              set IMAKECORE_PLATFORM=$$PLATFORM && \
              set IMAKECORE_ARCH=$$ARCH && \
              set IMAKECORE_COMPILER=$$COMPILER && \
              set IMAKECORE_COMPILER_VERSION=$$COMPVER && \
              set IMAKECORE_BUILD_MODE=$$MODE && \
              set IMAKECORE_RUNTIMES=$$RUNTIMES && \
              set IMAKECORE_CPP_STD=$$CPPSTD && \
              set IMAKECORE_EXCEPTION_ENABLED=$$EXC_EN && \
              set IMAKECORE_RTTI_ENABLED=$$RTTI_EN && \
              $$python -B $$script_path $$PWD qmake
    }
    unix {
        cmd = IMAKECORE_ROOT="$$IMAKECORE_ROOT" \
              IMAKECORE_SYSTEM="$$IMAKECORE_SYSTEM" \
              IMAKECORE_EXECUTABLE_PATH="$$EXE_PATH" \
              IMAKECORE_TARGET_TYPE="$$TARGET_TYPE" \
              IMAKECORE_PLATFORM="$$PLATFORM" \
              IMAKECORE_ARCH="$$ARCH" \
              IMAKECORE_COMPILER="$$COMPILER" \
              IMAKECORE_COMPILER_VERSION="$$COMPVER" \
              IMAKECORE_BUILD_MODE="$$MODE" \
              IMAKECORE_RUNTIMES="$$RUNTIMES" \
              IMAKECORE_CPP_STD="$$CPPSTD" \
              IMAKECORE_EXCEPTION_ENABLED="$$EXC_EN" \
              IMAKECORE_RTTI_ENABLED="$$RTTI_EN" \
              $$python -B $$script_path $$PWD qmake
    }

    res = $$system($$cmd, blob, result)
    ! isEqual(res, "") {
        message($$res)
    }
    ! isEqual(result, 0) {
        error("packages configuration failed")
        return(false)
    }
    message("packages configured successfully")
    return(true)
}

defineTest(findPythonInterpreter) {
    win32 {
        python = $$system(where python /F)
        python = $$first(python)
        isEmpty(python): python = $$system(where python3)
    } else {
        python = $$system(which python3 || which python)
    }
    isEmpty(python): {
        error("Python interpreter not found")
        return(false)
    }
    export(python)
    return(true)
}

defineReplace(getPythonFilePath){
    script_path = $$IMAKECORE_SYSTEM/$$1
    !exists($$script_path) {
        error("script not found at $$script_path")
    }
    script_path = $$absolute_path($$script_path)
    return ("$$script_path")
}
